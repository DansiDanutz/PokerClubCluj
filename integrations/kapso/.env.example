# Kapso / WhatsApp — copy these into the WorldCup26 app env (do NOT commit real values)

# From the Kapso dashboard. ROTATE the key that was pasted into chat.
KAPSO_API_KEY=

# Your WhatsApp phone number id (from Kapso).
KAPSO_PHONE_NUMBER_ID=

# Webhook signing secret (Kapso account settings) — used to verify inbound webhooks.
KAPSO_WEBHOOK_SECRET=

# Kapso base URL for the SDK.
KAPSO_BASE_URL=https://app.kapso.ai/api/meta/

# Where to send users to join (general link; per-user referral links are generated in-app).
WC26_JOIN_URL=https://worldcup26.world/login
