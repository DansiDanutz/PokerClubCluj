{
  "name": "pokercluj",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audit:ci": "npm audit --audit-level=high",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run audit:ci && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "15.5.22",
    "postcss": "8.5.23",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "typescript": "5.4.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
